# --- Supabase (from `supabase start`, or your hosted project settings) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — used by the Edge Function for server-side writes.
# This BYPASSES Row Level Security on purpose. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider: "mock" | "openai" | "mistral" ---
# "mock" lets you build and run the whole pipeline with no API key.
# "mistral" is not implemented — see README.
LLM_PROVIDER=mock
OPENAI_API_KEY=
MISTRAL_API_KEY=

# --- LLM tuning (all optional; the defaults shown are what the code uses) ---
# Primary model, and the stronger one the retry ladder escalates to when the
# primary keeps returning output that fails validation.
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o

# Per-request timeout for a single LLM call, in ms.
LLM_TIMEOUT_MS=30000

# --- Demo / testing -----------------------------------------------------------
# Makes the MOCK provider return deliberately invalid output so the
# retry -> repaired-prompt -> fallback path can be exercised with no API key:
#   "off"    normal, always valid           (default)
#   "first"  attempt 1 is invalid, attempt 2 recovers
#   "always" every attempt is invalid, the company ends up 'failed'
MOCK_CHAOS=off
